; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="KeySight"
config/description="KeySight: vallende noten op de echte piano, wachtmodus, MIDI-bestanden, feedback en automatische kalibratie."
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="KeySight"
config/features=PackedStringArray("4.7", "Mobile")

[audio]

driver/mix_rate=48000

[display]

window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/environment_blend_mode=0
openxr/startup_alert=false
shaders/enabled=true
